/target
# Release binaries built by hand: ~100 MB each, and a public repository is
# the wrong place for them.
/artifact
*.failed
*_failed
run.sh
# The end-to-end test bed's script is ours (the line above is for local run scripts).
!tools/hearth/e2e/run.sh
.*
!.gitignore
!.forgejo
!deploy/compose/.env.example
!.gitattributes
!.github
!.gitlab-ci.yml
!.gitea
!.cargo

# The cutover rehearsal writes its fixture and state here.
tools/fork/cutover-rehearsal/before.json
tools/fork/cutover-rehearsal/phase2_notes.json

# Python's bytecode cache, wherever the tools run from.
__pycache__/
/dist

# A deployment's own settings and secrets, never the example's
/deploy/compose/.env
/deploy/compose/secrets/
/deploy/compose/etc/
/deploy/compose/data/

# Core dumps from crashed test runs
core.[0-9]*
