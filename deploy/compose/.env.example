# Copy to .env and fill in. deploy/compose/README.md explains each.

# The server image (ci/build-image.sh builds it as hearth-mail:<commit>).
HEARTH_MAIL_IMAGE=hearth-mail:CHANGE-ME
# The mail host name (fully qualified, with an MX or A record): EHLO, the
# default certificate name, the node's name.
HEARTH_MAIL_HOSTNAME=mail.example.org
# The address people and apps use for JMAP and the web pages.
HEARTH_MAIL_PUBLIC_URL=https://mail.example.org
# The admin console's own address, if it has one (allowed to call the API).
HEARTH_MAIL_ADMIN_URL=https://admin.mail.example.org

# "all": JMAP and the API accept passwords as well as tokens (for webmail
# and tools that can't do OAuth). Leave unset for tokens only.
# HEARTH_MAIL_HTTP_BASIC_AUTH=all

# Where the mail ports listen on the host (0.0.0.0: every address).
HEARTH_MAIL_BIND=0.0.0.0
# Host ports, if the defaults are taken:
# HEARTH_MAIL_PORT_SMTP=25
# HEARTH_MAIL_PORT_SUBMISSIONS=465
# HEARTH_MAIL_PORT_SUBMISSION=587
# HEARTH_MAIL_PORT_IMAP=143
# HEARTH_MAIL_PORT_IMAPS=993
# HEARTH_MAIL_PORT_POP3S=995
# HEARTH_MAIL_PORT_SIEVE=4190
# HEARTH_MAIL_PORT_HTTPS=443
# HEARTH_MAIL_PORT_HTTP=8080
# HEARTH_MAIL_PORT_ADMIN=8081

# Unbound's network. Change only if 172.30.53.0/24 is in use on this host;
# the address must be inside the subnet.
# HEARTH_MAIL_DNS_SUBNET=172.30.53.0/24
# HEARTH_MAIL_DNS_IP=172.30.53.53
